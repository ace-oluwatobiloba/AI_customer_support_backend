# ============================================================
# DJANGO APPLICATION
# ============================================================
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# POSTGRESQL DATABASE
# ============================================================
DB_NAME=ai_customer_support
DB_USER=ai_support_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# Used by Podman Compose to initialize PostgreSQL.
# Keep this equal to DB_PASSWORD.
CONTAINER_DB_PASSWORD=change-this-password

# ============================================================
# REDIS AND CELERY
# ============================================================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ============================================================
# AI KNOWLEDGE SERVICES
# ============================================================
GEMINI_API_KEY=replace-with-your-ai-provider-api-key
GEMINI_GENERATION_MODEL=replace-with-your-generation-model

# ============================================================
# RESEND EMAIL CONFIGURATION
# ============================================================
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT=15
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ============================================================
# PUBLIC APPLICATION URL
# ============================================================
PUBLIC_API_BASE_URL=http://127.0.0.1:8000


# ============================================================
# OBJECT STORAGE — BACKBLAZE B2 (S3-compatible API)
# Keep these values in .env; never commit actual credentials.
# ============================================================
USE_B2_STORAGE=false
B2_BUCKET_NAME=ai-customer-support-kb-prod
B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_KEY_ID=replace-with-backblaze-application-key-id
B2_APPLICATION_KEY=replace-with-backblaze-application-key

# ============================================================
# ORGANIZATION BRANDING
# ============================================================
ORGANIZATION_NAME=Customer Support
ORGANIZATION_TAGLINE=Helpful answers. Human support. A better experience.
ORGANIZATION_SUPPORT_EMAIL=
ORGANIZATION_SUPPORT_PHONE=
