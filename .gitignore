@'
# Environment variables and secrets
.env
.env.*
!.env.example

# Python environments
.venv/
venv/
env/

# Python generated files
__pycache__/
*.py[cod]
*.pyd

# Django generated files
staticfiles/
media/

# Logs
*.log

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test and coverage output
.coverage
htmlcov/
.pytest_cache/
'@ | Set-Content .gitignore

@'

# Local databases
db.sqlite3
db.sqlite3-journal

# Archives and temporary test bundles
*.zip
'@ | Add-Content .gitignore